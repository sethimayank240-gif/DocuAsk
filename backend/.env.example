# Copy to .env and edit. Never commit .env to git.

# Retrieval method: tfidf | bm25 | dense
RETRIEVER=bm25
CHUNK_SIZE=256          # words per chunk
CHUNK_OVERLAP=50        # words shared between neighbouring chunks
TOP_K=4

# LLM (any OpenAI-compatible chat API: OpenAI, Groq, OpenRouter, ...).
# If LLM_API_KEY is empty the app still works and shows the best-matching passages.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Browser origin allowed to call the API when not using the Vite dev proxy
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10
